---
/** Compact sample of the core components, rendered inside a forced theme. */
import Badge from '@/components/ui/Badge.astro';
import Ja from '@/components/ja/Ja.astro';
import Icon from '@/components/ui/Icon.astro';
import ProgressBar from '@/components/ui/ProgressBar.astro';
import Tanuki from '@/components/mascot/Tanuki.astro';

interface Props {
  theme: 'light' | 'dark';
}
const { theme } = Astro.props;
---

<div data-theme={theme} class="rounded-[16px] border-2 border-line bg-paper p-4 text-ink sm:p-5">
  <p class="mb-3 font-display text-lg font-semibold capitalize">{theme} mode</p>
  <div class="sticker-card cat-phone mb-4 p-4">
    <div class="mb-2 flex items-center justify-between gap-2">
      <Badge category="phone"><Icon name="phone" size={14} /> Phone</Badge>
      <Tanuki pose="wave" size={48} />
    </div>
    <Ja text="{少々|しょうしょう}お{待|ま}ちください。" en="One moment, please." as="p" />
    <ProgressBar value={6} max={10} label="Lesson progress" category="phone" class="mt-3" />
  </div>
  <div class="flex flex-wrap gap-3">
    <button type="button" class="btn btn-primary">Check answer</button>
    <button type="button" class="btn btn-secondary">Skip</button>
  </div>
  <div class="mt-4 grid gap-2">
    <div class="option" data-state="correct">
      <span class="option-key text-success"><Icon name="check" size={16} /></span>
      <span lang="ja" class="flex-1">かしこまりました</span>
      <span class="text-sm font-semibold text-success">Correct</span>
    </div>
    <div class="option" data-state="incorrect">
      <span class="option-key text-error"><Icon name="x" size={16} /></span>
      <span lang="ja" class="flex-1">わかった</span>
      <span class="text-sm font-semibold text-error">Your answer</span>
    </div>
  </div>
</div>
