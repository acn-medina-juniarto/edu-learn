---
/** Small inline icon set (stroke icons, currentColor). Decorative unless `label` is set. */
export type IconName =
  | 'check'
  | 'x'
  | 'speaker'
  | 'sun'
  | 'moon'
  | 'flame'
  | 'arrow-right'
  | 'cards'
  | 'book'
  | 'info'
  | 'eye'
  | 'eye-off'
  | 'globe'
  | 'phone'
  | 'mail'
  | 'sparkle'
  | 'rotate';
interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  x: '<path d="M6 6l12 12M18 6L6 18"/>',
  speaker:
    '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4 4 0 010 6M18 6.5a7.5 7.5 0 010 11"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>',
  moon: '<path d="M19.5 14.5A8 8 0 019.5 4.5a8 8 0 1010 10z"/>',
  flame:
    '<path d="M12 21c3.9 0 6.5-2.6 6.5-6.2 0-3.4-2.3-5.6-3.9-7.8-.4 1.8-1.3 3-2.4 3.6.3-3-1-5.8-3.7-7.6.2 3-1.5 4.8-3 6.6C4.2 11.2 5.5 21 12 21z"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  cards: '<rect x="3" y="6" width="13" height="15" rx="2"/><path d="M8 3h11a2 2 0 012 2v12"/>',
  book: '<path d="M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M4 19V5M8 7h7"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5v.5"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>',
  'eye-off':
    '<path d="M3 3l18 18M10.6 6a9.6 9.6 0 011.4-.1c6 0 9.5 6.1 9.5 6.1a17 17 0 01-3 3.6M6.6 6.7A16.6 16.6 0 002.5 12s3.5 6.5 9.5 6.5a9 9 0 004.4-1.1"/><path d="M9.9 9.9a3 3 0 004.2 4.2"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.5 5.7 3.5 9s-1 6.3-3.5 9c-2.5-2.7-3.5-5.7-3.5-9S9.5 5.7 12 3z"/>',
  phone:
    '<path d="M5 3.5h3.5l1.5 4.5-2 1.5a11 11 0 006.5 6.5l1.5-2 4.5 1.5V19a2 2 0 01-2 2A16.5 16.5 0 013 5.5a2 2 0 012-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5L12 13l8.5-6.5"/>',
  sparkle: '<path d="M12 3l2 6.5L20.5 12 14 14l-2 7-2-7-6.5-2L10 9.5z"/>',
  rotate: '<path d="M20 11a8 8 0 10-2.3 5.7"/><path d="M20 4v7h-7"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>
