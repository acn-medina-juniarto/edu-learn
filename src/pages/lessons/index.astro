---
import Base from '@/layouts/Base.astro';
import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import Icon from '@/components/ui/Icon.astro';
import Ja from '@/components/ja/Ja.astro';
import PolitenessTag from '@/components/ja/PolitenessTag.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { CATEGORIES } from '@/lib/categories';
import { getLessons } from '@/lib/content';

const lessons = await getLessons();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const icon = { meetings: 'book', phone: 'phone', email: 'mail', keigo: 'sparkle' } as const;
---

<Base title="Lessons" description="Business Japanese lessons for English speakers.">
  <SectionHeading level={1} category="email">Lessons</SectionHeading>
  <p class="mb-6 max-w-prose text-ink-soft">
    Short lessons of 10–12 minutes, each with a dialogue, key vocabulary, keigo, grammar and culture notes, and a
    short quiz.
  </p>
  <ol class="grid gap-5 sm:grid-cols-2">
    {
      lessons.map((l) => (
        <li>
          <Card category={l.category} strip as="article" class="h-full">
            <div class="flex flex-wrap items-center gap-2">
              <Badge category={l.category}>
                <Icon name={icon[l.category]} size={14} /> {CATEGORIES[l.category].label}
              </Badge>
              <Badge category="primary">JLPT {l.level}</Badge>
              <PolitenessTag level={l.politeness} />
            </div>
            <h2 class="mt-3 text-xl">
              <a href={`${base}/lessons/${l.id}`} class="stretched-link underline-offset-4 hover:underline">
                <span class="text-ink-soft">{l.order}.</span> {l.title}
              </a>
            </h2>
            <Ja as="p" text={l.titleJa} />
            <p class="mt-1 text-ink-soft">{l.summary}</p>
            <p class="mt-3 text-sm text-ink-soft">
              {l.minutes} min · {l.vocab.length} words · {l.dialogue.lines.length} dialogue lines · {l.quiz.length} quiz
              questions
            </p>
          </Card>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  /* Whole card is clickable via the title link */
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
  }
  .stretched-link:focus-visible {
    outline: none;
  }
  .stretched-link:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  :global(.sticker-card:has(.stretched-link)) {
    transition: transform 80ms, box-shadow 80ms;
  }
  :global(.sticker-card:has(.stretched-link:hover)) {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow);
  }
</style>
